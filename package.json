{
	"name": "nvr",
	"license": "MIT",
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"build:bin": "bash ./tools/build.sh",
		"dev": "turbo run dev",
		"lint": "biome check .",
		"check-types": "turbo run check-types",
		"format": "biome format --write .",
		"dev:dashboard": "turbo run dev --filter=@nvr/dashboard",
		"dev:landing": "turbo run dev --filter=@nvr/landing",
		"dev:mobile": "turbo run dev --filter=@nvr/mobile",
		"dev:server": "turbo run dev --filter=@nvr/server",
		"dev:mediamtx": "turbo run dev --filter=@nvr/mediamtx",
		"gen:api": "turbo run gen --filter=@nvr/api-client",
		"lint:fix": "biome check --write .",
		"check": "biome check .",
		"gen:server": "cd server && make generate"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.5",
		"turbo": "^2.10.5",
		"typescript": "5.9.2"
	},
	"engines": {
		"node": ">=18"
	},
	"devEngines": {
		"packageManager": {
			"name": "bun",
			"version": "1.3.14"
		}
	},
	"workspaces": [
		"apps/*",
		"packages/*",
		"server",
		"tools/*"
	],
	"packageManager": "bun@1.3.14"
}
