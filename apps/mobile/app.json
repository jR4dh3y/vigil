{
	"expo": {
		"name": "Vigil",
		"slug": "vigil",
		"version": "0.0.1",
		"orientation": "portrait",
		"icon": "./assets/icon.png",
		"scheme": "vigil",
		"userInterfaceStyle": "automatic",
		"newArchEnabled": true,
		"ios": {
			"supportsTablet": true,
			"bundleIdentifier": "com.nvr.app",
			"infoPlist": {
				"NSLocalNetworkUsageDescription": "Vigil connects to your recorder on the local network.",
				"NSAppTransportSecurity": {
					"NSAllowsLocalNetworking": true
				}
			}
		},
		"android": {
			"adaptiveIcon": {
				"backgroundColor": "#0a0a0a",
				"foregroundImage": "./assets/android-icon-foreground.png",
				"backgroundImage": "./assets/android-icon-background.png",
				"monochromeImage": "./assets/android-icon-monochrome.png"
			},
			"package": "com.nvr.app"
		},
		"web": {
			"favicon": "./assets/favicon.png"
		},
		"plugins": [
			"expo-router",
			"expo-secure-store",
			[
				"expo-notifications",
				{
					"icon": "./assets/icon.png"
				}
			]
		],
		"experiments": {
			"typedRoutes": true
		}
	}
}
