---
import "../styles/global.css";

interface Props {
	title: string;
	description?: string;
}

const {
	title,
	description = "Vigil is a self-hosted network video recorder. Live view, continuous recording, timeline playback and alerts for your RTSP/ONVIF cameras — one Go binary, your own disk, no cloud.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
	</head>
	<body class="bg-[#f3eee3] text-[#10130f] antialiased">
		<slot />
		<script src="../scripts/main.ts"></script>
	</body>
</html>
