---
import { ArrowDownRight, Copy } from "lucide-astro";
import AppPreview from "./AppPreview.astro";
import OwlMark from "./OwlMark.astro";

const install =
	"git clone https://github.com/jR4dh3y/vigil.git && cd vigil/deploy && docker compose up -d --build";
---

<main id="top">
	<section class="mx-auto max-w-[1440px] px-4 pb-8 pt-16 sm:px-7 sm:pb-12 sm:pt-24">
		<div class="grid gap-10 lg:grid-cols-[1.15fr_0.85fr] lg:gap-16">
			<div>
				<p class="mono-type mb-5 flex items-center gap-3 text-[11px] uppercase sm:text-xs">
					<span class="size-2 rounded-full bg-[#c88969]"></span>
					A quiet NVR for loud cameras
				</p>
				<h1 class="display-type max-w-4xl text-[clamp(4.8rem,13vw,12rem)] uppercase leading-[0.76] text-[#10130f]">
					Watch<br />what<br /><span class="text-[#7c8e75]">matters.</span>
				</h1>
				<div class="mt-10 grid max-w-2xl gap-6 sm:grid-cols-[1fr_auto] sm:items-end">
					<p class="max-w-sm text-base leading-snug sm:text-lg">
						Vigil records your RTSP/ONVIF cameras to your own hardware. Live view, playback,
						alerts — one small Go server, no cloud-shaped middleman.
					</p>
					<a href="#features" class="group flex items-center gap-2 text-xs uppercase underline underline-offset-4">
						See the essentials
						<ArrowDownRight class="size-4 transition-transform group-hover:translate-x-1 group-hover:translate-y-1" />
					</a>
				</div>
			</div>

			<div class="relative min-h-[420px] overflow-hidden border-l-0 border-[#10130f] bg-[#7c8e75] p-5 sm:p-8 lg:mt-8 lg:min-h-[540px] lg:border-l">
				<div class="absolute inset-0 opacity-20 [background-image:linear-gradient(90deg,transparent_49%,#10130f_50%,transparent_51%),linear-gradient(transparent_49%,#10130f_50%,transparent_51%)] [background-size:34px_34px]"></div>
				<div class="relative flex items-start justify-between text-[10px] uppercase text-[#10130f]/70">
					<span class="mono-type">VIGIL / 001</span>
					<span class="mono-type">YOUR DISK / ALWAYS</span>
				</div>
				<OwlMark class="absolute -right-12 bottom-0 w-[min(92%,520px)] opacity-90 mix-blend-multiply sm:-right-16" decorative />
				<div class="absolute bottom-5 left-5 right-5 flex items-end justify-between border-t border-[#10130f]/40 pt-3 text-xs uppercase sm:bottom-8 sm:left-8 sm:right-8">
					<span class="max-w-[12rem] leading-tight">An owl with a very good memory.</span>
					<span class="mono-type text-right">MIT / 2026</span>
				</div>
			</div>
		</div>

		<div class="mt-16 border-t-2 border-[#10130f] pt-3 sm:mt-24">
			<p class="mono-type text-[10px] uppercase">Live view / timeline / alerts</p>
		</div>
		<div class="mt-3" aria-label="Vigil dashboard preview">
			<AppPreview />
		</div>
	</section>

	<section id="install" class="scroll-mt-8 border-y border-[#10130f]/20 bg-[#10130f] px-4 py-7 text-[#f3eee3] sm:px-7">
		<div class="mx-auto grid max-w-[1440px] gap-5 lg:grid-cols-[0.35fr_1fr_auto] lg:items-center">
			<p class="mono-type text-[10px] uppercase text-[#f3eee3]/60">02 / Put it on the box</p>
			<pre class="mono-type overflow-x-auto text-xs leading-relaxed sm:text-sm"><code><span class="text-[#c88969]">$</span> git clone github.com/jR4dh3y/vigil && cd vigil/deploy && docker compose up -d --build</code></pre>
			<button type="button" data-copy={install} class="inline-flex w-fit cursor-pointer items-center gap-2 border border-[#f3eee3]/40 px-3 py-2 text-xs uppercase transition-colors hover:bg-[#f3eee3] hover:text-[#10130f]"><Copy class="size-3" /> Copy</button>
		</div>
	</section>
</main>
