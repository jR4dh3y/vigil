---
import { ArrowDownRight, ArrowUpRight, Copy } from "lucide-astro";
import OwlMark from "./OwlMark.astro";

const install =
	"git clone https://github.com/jR4dh3y/vigil.git && cd vigil/deploy && docker compose up -d --build";
---

<main id="top">
	<section class="sticky top-0 z-0 h-[100svh] overflow-hidden">
		<img
			src="/assets/hero-night-clean.webp"
			alt="A warmly lit house beneath a star-filled night sky"
			class="absolute inset-0 h-full w-full object-cover object-[16%_50%] will-change-transform sm:object-[36%_50%]"
			width="1536"
			height="710"
			decoding="async"
			data-hero-img
		/>

		<div class="absolute inset-x-0 top-0 flex h-[70%] flex-col overflow-hidden bg-[#f3eee3] will-change-transform" data-hero-text>
			<header class="mx-auto flex w-full max-w-[1440px] items-center justify-between px-4 pt-5 sm:px-7 sm:pt-7">
				<a href="#top" class="group flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.18em]">
					<OwlMark class="size-8 object-contain transition-transform duration-300 group-hover:-rotate-6" />
					<span>Vigil</span>
				</a>
				<nav class="flex items-center gap-3 sm:gap-5">
					<a href="#features" class="hidden text-[11px] uppercase underline-offset-4 hover:underline sm:inline">Features</a>
					<a href="#install" class="group flex items-center gap-1 rounded-full border border-[#10130f] px-3 py-1.5 text-[11px] uppercase transition-colors hover:bg-[#10130f] hover:text-[#f3eee3]">
						<span>Install</span>
						<ArrowUpRight class="size-3 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
					</a>
				</nav>
			</header>

			<div class="mx-auto grid w-full max-w-[1440px] flex-1 content-center items-center gap-8 px-4 pb-10 sm:px-7 lg:grid-cols-[1.3fr_0.7fr] lg:items-end">
				<h1 class="display-type text-[clamp(4rem,10.5vw,11rem)] uppercase leading-[0.76] text-[#10130f]">
					Watch<br />what<br /><span class="text-[#7c8e75]">matters.</span>
				</h1>
				<div class="relative z-10 lg:justify-self-end">
					<OwlMark
						class="pointer-events-none mx-auto mb-[-1.25rem] block w-[clamp(8rem,18vw,16rem)] opacity-[0.16] mix-blend-multiply sm:mb-[-1.5rem] sm:w-[clamp(10rem,20vw,18rem)]"
						decorative
					/>
					<p class="relative z-10 max-w-xs text-base leading-snug sm:text-lg">
						Vigil records your RTSP/ONVIF cameras to your own hardware. Live view, playback,
						alerts — one small Go server, no cloud-shaped middleman.
					</p>
					<a href="#install" class="group mt-6 inline-flex items-center gap-2 text-xs uppercase underline underline-offset-4">
						Install Vigil
						<ArrowDownRight class="size-4 transition-transform group-hover:translate-x-1 group-hover:translate-y-1" />
					</a>
				</div>
			</div>
		</div>
	</section>

	<div class="h-[70svh]" aria-hidden="true"></div>

	<section id="install" class="relative z-20 mt-16 scroll-mt-8 border-y border-[#10130f]/20 bg-[#10130f] px-4 py-7 text-[#f3eee3] sm:mt-24 sm:px-7">
		<div class="mx-auto grid max-w-[1440px] gap-5 lg:grid-cols-[0.35fr_1fr_auto] lg:items-center">
			<p class="mono-type text-[10px] uppercase text-[#f3eee3]/60">02 / Put it on the box</p>
			<pre class="mono-type overflow-x-auto text-xs leading-relaxed sm:text-sm"><code><span class="text-[#c88969]">$</span> git clone github.com/jR4dh3y/vigil && cd vigil/deploy && docker compose up -d --build</code></pre>
			<button type="button" data-copy={install} class="inline-flex w-fit cursor-pointer items-center gap-2 border border-[#f3eee3]/40 px-3 py-2 text-xs uppercase transition-colors hover:bg-[#f3eee3] hover:text-[#10130f]"><Copy class="size-3" /> Copy</button>
		</div>
	</section>
</main>
