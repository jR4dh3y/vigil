---
import { Github } from "lucide-astro";
import OwlMark from "./OwlMark.astro";
---

<footer class="border-t border-[#f3eee3]/15 text-[#f3eee3]">
	<div class="mx-auto flex w-full max-w-[1440px] flex-wrap items-center justify-between gap-x-6 gap-y-3 px-4 py-6 sm:px-7 sm:py-8">
		<div class="flex items-center gap-3">
			<OwlMark class="size-10 object-contain" />
			<span class="display-type text-3xl uppercase leading-none">Vigil</span>
		</div>

		<nav class="flex flex-wrap items-center gap-x-6 gap-y-3 text-xs uppercase text-[#f3eee3]/55">
			<a
				href="https://github.com/jR4dh3y/vigil"
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex items-center gap-1.5 transition-colors hover:text-[#f3eee3]"
			>
				<Github class="size-3.5" />
				Source
			</a>
			<a href="/privacy" class="transition-colors hover:text-[#f3eee3]">Privacy</a>
			<span class="whitespace-nowrap">By Radhey Kalra</span>
		</nav>
	</div>
</footer>
