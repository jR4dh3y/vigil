---
type FooterLink = { label: string; href: string; external?: boolean };

const links: FooterLink[] = [
	{ label: "Quickstart", href: "/docs/quickstart" },
	{ label: "Docs", href: "/docs" },
	{ label: "Source", href: "https://github.com/jR4dh3y/vigil", external: true },
	{ label: "Privacy", href: "/privacy" },
];
---

<footer class="shrink-0 border-t border-white/15 bg-black/10 text-white">
	<div class="mx-auto w-full max-w-[1440px] px-4 py-3 sm:px-7">
		<div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
			<div class="flex flex-col gap-1.5 sm:flex-row sm:items-end sm:gap-5">
				<span class="display-type text-3xl uppercase leading-none">Vigil</span>
				<p class="text-xs text-[#f3eee3]/45">Your cameras. Your hardware. Your footage.</p>
			</div>
			<nav aria-label="Footer" class="flex flex-wrap items-center gap-x-5 gap-y-2 text-[10px] uppercase tracking-[0.1em] text-white/65">
				{links.map(({ label, href, external }) => (
					<a
						href={href}
						target={external ? "_blank" : undefined}
						rel={external ? "noopener noreferrer" : undefined}
						class="transition-colors hover:text-white"
					>
						{label}
					</a>
				))}
			</nav>
		</div>

		<div class="mt-2.5 flex flex-wrap items-center justify-between gap-x-5 gap-y-1 border-t border-white/10 pt-2.5 text-[9px] uppercase tracking-[0.1em] text-white/45">
			<span>MIT Licensed</span>
			<span>By Radhey Kalra</span>
		</div>
	</div>
</footer>
