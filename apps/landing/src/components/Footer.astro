---
import { Github } from "lucide-astro";
import OwlMark from "./OwlMark.astro";
---


<footer class="border-t-2 border-[#1e1e20] bg-[#1e1e20] text-[#f3eee3]">
	<div class="mx-auto flex max-w-[1440px] flex-col gap-8 px-4 py-10 sm:px-7 sm:py-14 md:flex-row md:items-end md:justify-between">
		<div class="flex items-end gap-4">
			<OwlMark class="size-16 object-contain" />
			<div>
				<span class="display-type text-5xl uppercase leading-none">Vigil</span>
				<p class="mt-2 text-xs uppercase text-[#f3eee3]/55">Self-hosted NVR · local storage</p>
			</div>
		</div>

		<div class="flex flex-col items-start gap-4 text-xs uppercase text-[#f3eee3]/55 md:items-end">
			<a
				href="https://github.com/jR4dh3y/vigil"
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex items-center gap-1.5 border border-[#f3eee3]/40 px-2.5 py-1.5 text-[#f3eee3] transition-colors hover:bg-[#f3eee3] hover:text-[#1e1e20]"
			>
				<Github class="size-3.5" />
				Source
			</a>
		</div>
	</div>
</footer>
