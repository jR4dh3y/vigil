---
import { Github } from "lucide-astro";
import OwlMark from "./OwlMark.astro";
---

<footer class="border-t border-white/15 text-white">
	<div class="mx-auto flex w-full max-w-[1440px] flex-wrap items-center justify-between gap-x-6 gap-y-3 px-4 py-6 sm:px-7 sm:py-8">
		<div class="flex items-center gap-3 sm:gap-4">
			<div class="relative size-14 shrink-0 -rotate-3 sm:size-16">
				<img
					src="/assets/owl-paper-bg.png"
					alt=""
					aria-hidden="true"
					class="block h-full w-full object-contain"
					width="1254"
					height="1254"
					decoding="async"
				/>
				<OwlMark class="absolute inset-0 m-auto h-[65%] w-[65%] object-contain" />
			</div>
			<span class="display-type text-3xl uppercase leading-none text-white sm:text-4xl">Vigil</span>
		</div>
		<nav class="flex flex-wrap items-center gap-x-6 gap-y-3 text-xs uppercase text-white/55">
			<a
				href="https://github.com/jR4dh3y/vigil"
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex items-center gap-1.5 transition-colors hover:text-white"
			>
				<Github class="size-3.5" />
				Source
			</a>
			<a href="/privacy" class="transition-colors hover:text-white">Privacy</a>
			<span class="whitespace-nowrap">By Radhey Kalra</span>
		</nav>
	</div>
</footer>
