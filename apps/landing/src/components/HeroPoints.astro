---
import HangingOwl from "./HangingOwl.astro";
import HeroPoint from "./HeroPoint.astro";

/* Each point is a paper tag cut from the lifted page, hanging from the top
   edge on a vine. Vine lengths alternate short/long so neighbouring tags
   never collide while they sway. */
const points = [
	{
		text: "Watch on any screen you own.",
		len: "2.6rem",
		lenSm: "3rem",
		lenLg: "4.5rem",
		lenShort: "2rem",
		tilt: -2.4,
		cropX: 25,
		cropY: 25,
		dur: 6.4,
		delay: -1.2,
	},
	{
		text: "Runs on your hardware.",
		len: "7.4rem",
		lenSm: "8rem",
		lenLg: "11rem",
		lenShort: "3.5rem",
		tilt: 1.8,
		cropX: 50,
		cropY: 25,
		dur: 7.6,
		delay: -3.1,
	},
	{
		text: "No recurring charges.",
		len: "3.4rem",
		lenSm: "4rem",
		lenLg: "6rem",
		lenShort: "2.6rem",
		tilt: -1.2,
		cropX: 75,
		cropY: 25,
		dur: 5.8,
		delay: -0.6,
	},
	{
		text: "Open source.",
		len: "8.2rem",
		lenSm: "9rem",
		lenLg: "12.5rem",
		lenShort: "4rem",
		tilt: 2.6,
		cropX: 25,
		cropY: 50,
		dur: 7,
		delay: -4.4,
	},
	{
		text: "Your recordings stay on your hardware.",
		len: "2.4rem",
		lenSm: "3.5rem",
		lenLg: "5rem",
		lenShort: "2.2rem",
		tilt: -2,
		cropX: 50,
		cropY: 50,
		dur: 6.8,
		delay: -2.3,
	},
	{
		text: "Use Google Drive for backups.",
		len: "6.8rem",
		lenSm: "7.5rem",
		lenLg: "10rem",
		lenShort: "3.3rem",
		tilt: 1.4,
		cropX: 75,
		cropY: 50,
		dur: 7.9,
		delay: -5.2,
	},
];
---

<div class="pointer-events-none absolute inset-0 z-0 overflow-hidden">
	<HangingOwl />

	<ul
		class="points absolute right-0 top-0 z-30 flex w-full items-start px-4 sm:max-w-[76%] sm:px-8 xl:max-w-[940px]"
		aria-label="Vigil capabilities"
		data-hero-points
	>
		{points.map((point, i) => <HeroPoint {...point} flip={i % 2 === 1} stagger={i * 0.14} />)}
	</ul>
</div>

<style>
	.points {
		--vine-strand: rgba(195, 251, 91, 0.55);
		--vine-leaf: rgba(195, 251, 91, 0.32);
	}
</style>
