---
import { Camera, CameraOff, Circle, Settings, Video, Zap } from "lucide-astro";

type CameraState = "rec" | "online" | "motion" | "offline";

const cameras: Array<{
	channel: number;
	name: string;
	state: CameraState;
	meta: string;
}> = [
	{ channel: 1, name: "Front door", state: "rec", meta: "1080p · H.264 · main" },
	{ channel: 2, name: "Driveway", state: "online", meta: "720p · H.264 · sub" },
	{ channel: 3, name: "Backyard", state: "offline", meta: "Last seen 04:12" },
	{ channel: 4, name: "Garage", state: "motion", meta: "1080p · H.265 · main" },
];

const badge: Record<Exclude<CameraState, "offline">, string> = {
	rec: "border-red-500/30 bg-red-500/10 text-red-300",
	online: "border-emerald-500/30 bg-emerald-500/10 text-emerald-300",
	motion: "border-amber-500/30 bg-amber-500/10 text-amber-300",
};

const dot: Record<Exclude<CameraState, "offline">, string> = {
	rec: "bg-red-400",
	online: "bg-emerald-400",
	motion: "bg-amber-400",
};

const label: Record<Exclude<CameraState, "offline">, string> = {
	rec: "REC",
	online: "Online",
	motion: "Motion",
};

/* One coverage block ≈ one recorded stretch; gaps mean the camera was down. */
const coverage = [
	{ x: 0, w: 9 },
	{ x: 13, w: 14 },
	{ x: 27, w: 11, event: true },
	{ x: 44, w: 16 },
	{ x: 66, w: 12, event: true },
	{ x: 78, w: 22 },
];

const sideIcons = [
	{ icon: Video, active: true },
	{ icon: Camera, active: false },
	{ icon: Zap, active: false },
	{ icon: Settings, active: false },
];
---

<div
	class="overflow-hidden border-2 border-[#10130f] bg-[#10130f] shadow-[10px_10px_0_rgba(16,19,15,0.16)]"
>
	<div class="flex">
		<!-- Miniature of the real sidebar -->
		<div
			class="hidden w-12 shrink-0 flex-col items-center gap-1 border-r border-white/15 py-3 sm:flex"
		>
			<span
				class="mb-2 flex size-7 items-center justify-center bg-[#7c8e75] text-[#10130f]"
			>
				<Camera class="size-3.5" />
			</span>
			{
				sideIcons.map(({ icon: Icon, active }) => (
					<span
						class:list={["flex size-7 items-center justify-center", active ? "bg-white/10 text-white" : "text-white/35"]}
					>
						<Icon class="size-3.5" />
					</span>
				))
			}
		</div>

		<div class="min-w-0 flex-1">
			<!-- Live view header -->
			<div
				class="flex items-center justify-between border-b border-white/15 px-3 py-2.5"
			>
				<span class="flex items-center gap-2 text-xs font-medium uppercase tracking-[0.18em] text-white"><Circle class="size-2 fill-[#c88969] text-[#c88969]" /> Live / all cameras</span>
				<span class="flex items-center gap-2.5 text-[10px] uppercase text-white/45">
					<span>04 channels</span>
					<span data-clock class="tabular-nums">--:--:--</span>
				</span>
			</div>

			<!-- Camera grid, gap-px like the real one -->
			<div class="grid grid-cols-2 gap-px bg-white/15">
				{
					cameras.map((cam) => (
						<div class="relative aspect-video bg-[#171a16]">
							{cam.state === "offline" ? (
								<div class="absolute inset-0 flex flex-col items-center justify-center gap-1.5 bg-[#20241d]">
									<CameraOff class="size-4 text-white/30" />
									<span class="text-[10px] uppercase text-white/40">Offline</span>
								</div>
							) : (
								<>
									<div
										class:list={[
											"absolute inset-0",
											cam.channel % 2 === 0
											? "bg-[radial-gradient(ellipse_at_70%_30%,#606b56_0%,#141714_72%)]"
											: "bg-[radial-gradient(ellipse_at_30%_70%,#68745d_0%,#151814_72%)]",
										]}
									/>
									<span
										class:list={[
											"absolute top-2 right-2 inline-flex items-center gap-1 border px-1.5 py-0.5 text-[9px] font-medium uppercase backdrop-blur-sm",
											badge[cam.state],
										]}
									>
										<span
											class:list={[
												"size-1 rounded-full",
												dot[cam.state],
												cam.state === "rec" && "motion-safe:animate-pulse",
											]}
										/>
										{label[cam.state]}
									</span>
								</>
							)}
							<div class="pointer-events-none absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/80 to-transparent px-2 py-1.5">
								<p class="truncate text-[10px] font-medium uppercase tracking-[0.12em] text-white drop-shadow">
									CH{cam.channel} · {cam.name}
								</p>
							</div>
						</div>
					))
				}
			</div>

			<!-- Timeline, same shape as the real CoverageTimeline -->
			<div class="border-t border-white/15 px-3 py-2.5">
				<div class="mb-1.5 flex items-center justify-between text-[10px] uppercase text-white/45">
					<span>Playback — CH1 — last 24h</span>
					<span class="hidden sm:inline">Drag to scrub</span>
				</div>
				<div class="relative h-8 w-full border border-white/20 bg-black/20">
					<div class="absolute inset-1 overflow-hidden bg-white/10">
						{
							coverage.map((seg) => (
								<div
									class="absolute inset-y-0 bg-[#7c8e75]"
									style={`left: ${seg.x}%; width: ${seg.w}%`}
								>
									{seg.event && (
										<span class="absolute inset-y-0 left-1/2 w-px bg-amber-400" />
									)}
								</div>
							))
						}
					</div>
					<div
								class="pointer-events-none absolute inset-y-0 w-0.5 -translate-x-1/2 bg-[#c88969] shadow-[0_0_6px_rgba(200,137,105,0.6)]"
						style="left: 58%"
					>
						<div
										class="absolute top-1/2 left-1/2 size-2 -translate-x-1/2 -translate-y-1/2 rounded-full border-2 border-white bg-[#c88969]"
						>
						</div>
					</div>
				</div>
				<div class="mt-1 flex justify-between text-[9px] text-white/30 tabular-nums">
					<span>00:00</span><span>06:00</span><span>12:00</span><span>18:00</span><span
						>23:59</span
					>
				</div>
			</div>
		</div>
	</div>
</div>
