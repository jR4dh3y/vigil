---
import { BellRing, History, Video } from "lucide-astro";

const features = [
	{ icon: Video, name: "Live view", desc: "Open the current stream from the dashboard." },
	{ icon: History, name: "Playback", desc: "Browse recorded segments on your disk." },
	{ icon: BellRing, name: "Alerts", desc: "See camera and event changes without a cloud service." },
];
---

<section id="features" class="border-t border-[#1e1e20]/20 bg-[#c59edc]">
	<div class="mx-auto max-w-[1440px] px-4 py-14 sm:px-7 sm:py-20">
		<div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
			<h2 class="display-type text-[clamp(3.5rem,8vw,7rem)] uppercase leading-[0.78]">
				What it<br /><span class="text-[#f3eee3]">does.</span>
			</h2>
			<p class="max-w-xs text-sm uppercase leading-snug">
				Connect cameras, record locally, and review what happened.
			</p>
		</div>

		<div class="mt-12 grid gap-px border border-[#1e1e20]/30 bg-[#1e1e20]/30 sm:grid-cols-3">
			{features.map((feature) => (
				<div class="bg-[#c59edc] p-5 transition-colors hover:bg-[#f3eee3]">
					<span class="flex size-9 items-center justify-center bg-[#1e1e20] text-[#f3eee3]">
						<feature.icon class="size-4" />
					</span>
					<h3 class="mt-8 text-sm font-semibold uppercase">{feature.name}</h3>
					<p class="mt-1 text-sm text-[#1e1e20]/65">{feature.desc}</p>
				</div>
			))}
		</div>
	</div>
</section>
