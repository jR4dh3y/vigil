---
const faqs = [
	{
		q: "Which cameras work with the server?",
		a: "The server uses RTSP and ONVIF. Most IP cameras and DVRs support these protocols.",
	},
	{
		q: "Where does the server store recordings?",
		a: "The server stores recordings on its local disk. The server does not send video to the cloud.",
	},
	{
		q: "How do I watch cameras from another network?",
		a: "Use a VPN or a tunnel to your server. The server does not need an open port.",
	},
	{
		q: "What is the cost?",
		a: "The code is open source. You pay for the hardware that runs the server.",
	},
];
---

<section id="faq" class="px-4 pb-8 pt-8 sm:px-7 sm:pb-10 sm:pt-10 lg:flex-1 lg:min-h-0">
	<div class="mx-auto grid max-w-[1440px] gap-8 lg:h-full lg:grid-cols-[auto_minmax(0,1fr)] lg:items-start lg:gap-10">
		<div class="relative -rotate-3 w-[clamp(9rem,14vw,12rem)] lg:mt-1">
			<img
				src="/assets/owl-paper-bg.png"
				alt=""
				aria-hidden="true"
				class="block w-full object-contain"
				width="1254"
				height="1254"
				decoding="async"
			/>
			<img
				src="/assets/owl-question.png"
				alt=""
				aria-hidden="true"
				class="absolute inset-0 m-auto h-[58%] w-[58%] -translate-x-[2%] translate-y-[2.5%] object-contain"
				width="1254"
				height="1254"
				decoding="async"
			/>
		</div>

		<div class="border-l border-[#c59edc]/40 pl-5 sm:pl-8">
			{faqs.map(({ q, a }) => (
				<details data-faq-item class="group py-4 first:pt-0 last:pb-0">
					<summary class="flex cursor-pointer list-none items-start justify-between gap-6 [&::-webkit-details-marker]:hidden">
						<span class="display-type max-w-2xl text-xl uppercase leading-[0.92] sm:text-2xl">{q}</span>
						<span
							class="mono-type mt-0.5 flex size-7 shrink-0 items-center justify-center rounded-full bg-[#c59edc]/10 text-base leading-none text-[#c59edc] transition-transform duration-200 group-open:rotate-45"
							aria-hidden="true"
						>
							+
						</span>
					</summary>
					<p class="mt-3 max-w-2xl pr-8 text-base leading-relaxed text-[#f3eee3]/70">{a}</p>
				</details>
			))}
		</div>
	</div>
</section>

<script>
	const faqItems = Array.from(document.querySelectorAll<HTMLDetailsElement>("[data-faq-item]"));
	for (const item of faqItems) {
		item.addEventListener("toggle", () => {
			if (!item.open) return;
			for (const other of faqItems) {
				if (other !== item) {
					other.open = false;
				}
			}
		});
	}
</script>
