---
const faqs = [
	{
		q: "Which cameras work with the server?",
		a: "The server uses RTSP and ONVIF. Most IP cameras and DVRs support these protocols.",
	},
	{
		q: "Where does the server store recordings?",
		a: "The server stores recordings on its local disk. The server does not send video to the cloud.",
	},
	{
		q: "How do I watch cameras from another network?",
		a: "Use a VPN or a tunnel to your server. The server does not need an open port.",
	},
	{
		q: "What is the cost?",
		a: "The code is open source. You pay for the hardware that runs the server.",
	},
];
---

<section id="faq" class="px-4 pb-10 pt-12 sm:px-7 sm:pb-14 sm:pt-16 lg:flex-1 lg:min-h-0">
	<div class="mx-auto grid max-w-[1440px] gap-12 lg:h-full lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:items-stretch lg:gap-16 xl:gap-24">
		<div class="flex flex-col justify-between gap-10 lg:h-full">
			<div class="max-w-md">
				<p class="mono-type text-[10px] uppercase tracking-[0.12em] text-[#c59edc]">FAQ / Field notes</p>
				<h2 class="display-type mt-5 text-[clamp(4rem,7vw,7rem)] uppercase leading-[0.76]">
					Questions,<br /><span class="text-[#c59edc]">answered.</span>
				</h2>
				<p class="mt-7 max-w-sm text-base leading-relaxed text-[#f3eee3]/70 sm:text-lg">
					A small recorder should leave very little mystery behind. Here are the practical answers before
					you put Vigil on your hardware.
				</p>
			</div>

			<div class="relative -rotate-3 w-[clamp(9rem,14vw,12rem)] self-start">
				<img
					src="/assets/owl-paper-bg.png"
					alt=""
					aria-hidden="true"
					class="block w-full object-contain"
					width="1254"
					height="1254"
					decoding="async"
				/>
				<img
					src="/assets/owl-question.png"
					alt=""
					aria-hidden="true"
					class="absolute inset-0 m-auto h-[58%] w-[58%] -translate-x-[2%] translate-y-[2.5%] object-contain"
					width="1254"
					height="1254"
					decoding="async"
				/>
			</div>
		</div>

		<div class="lg:pt-3">
			<div class="mb-7 flex items-baseline justify-between gap-4 pl-5 sm:pl-8">
				<p class="text-sm text-[#f3eee3]/55 sm:text-base">The short version, without the sales pitch.</p>
				<span class="mono-type text-[10px] uppercase text-[#f3eee3]/45">4 questions</span>
			</div>

			<div class="border-l border-[#c59edc]/40 pl-5 sm:pl-8">
				{faqs.map(({ q, a }) => (
					<details data-faq-item class="group py-5 first:pt-0 last:pb-0">
						<summary class="flex cursor-pointer list-none items-start justify-between gap-6 [&::-webkit-details-marker]:hidden">
							<span class="display-type max-w-2xl text-2xl uppercase leading-[0.9] sm:text-3xl">{q}</span>
							<span
								class="mono-type mt-0.5 flex size-8 shrink-0 items-center justify-center rounded-full bg-[#c59edc]/10 text-lg leading-none text-[#c59edc] transition-transform duration-200 group-open:rotate-45"
								aria-hidden="true"
							>
								+
							</span>
						</summary>
						<p class="mt-4 max-w-2xl pr-8 text-base leading-relaxed text-[#f3eee3]/70 sm:text-lg">{a}</p>
					</details>
				))}
			</div>
		</div>
	</div>
</section>

<script>
	const faqItems = Array.from(document.querySelectorAll<HTMLDetailsElement>("[data-faq-item]"));
	for (const item of faqItems) {
		item.addEventListener("toggle", () => {
			if (!item.open) return;
			for (const other of faqItems) {
				if (other !== item) {
					other.open = false;
				}
			}
		});
	}
</script>
