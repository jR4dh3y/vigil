---
interface Props {
	text: string;
	/** Vine length per breakpoint. */
	len: string;
	lenSm: string;
	lenLg: string;
	/** Tag tilt in degrees. */
	tilt: number;
	/** Crop origin inside the paper sheet, in percent. */
	cropX: number;
	cropY: number;
	/** Mirror the vine so the leaves face the other way. */
	flip?: boolean;
	/** Sway timing in seconds; negative delays desync the tags. */
	dur: number;
	delay: number;
}

const { text, len, lenSm, lenLg, tilt, cropX, cropY, flip = false, dur, delay } = Astro.props;
---

<li
	class="hero-point flex min-w-0 flex-1 flex-col items-center"
	style={`--len:${len}; --len-sm:${lenSm}; --len-lg:${lenLg}; --tilt:${tilt}deg; --crop-x:${cropX}%; --crop-y:${cropY}%; --sway-dur:${dur}s; --sway-delay:${delay}s;`}
>
	<svg
		class:list={["hero-vine block", { "-scale-x-100": flip }]}
		viewBox="0 0 24 100"
		preserveAspectRatio="none"
		aria-hidden="true"
	>
		<path class="strand" d="M12 -2 C 8 22, 16 42, 11 62 C 8 76, 13 88, 12 97"></path>
		<path class="leaf" d="M10 36 C 4 34, 2 28, 3 24 C 8 26, 10 30, 10 36 Z"></path>
		<path class="leaf" d="M13 60 C 19 58, 21 52, 20 48 C 15 50, 13 54, 13 60 Z"></path>
		<circle class="knot" cx="12" cy="97" r="2.6"></circle>
	</svg>
	<span class="hero-tag">{text}</span>
</li>

<style>
	.hero-point {
		transform-origin: 50% 0;
		animation: hero-point-sway var(--sway-dur) ease-in-out var(--sway-delay) infinite alternate;
	}

	.hero-vine {
		width: 1.25rem;
		height: var(--len);
	}

	.strand {
		fill: none;
		stroke: var(--vine-strand);
		stroke-width: 2;
		stroke-linecap: round;
		vector-effect: non-scaling-stroke;
	}

	.leaf {
		fill: var(--vine-leaf);
	}

	.knot {
		fill: var(--vine-strand);
	}

	.hero-tag {
		margin-top: -0.2rem;
		max-width: 5.75rem;
		padding: 0.45rem 0.5rem;
		border-radius: 3px;
		background-color: var(--paper);
		background-image: url("/assets/owl-paper-bg.png");
		background-size: 300% auto;
		background-position: var(--crop-x) var(--crop-y);
		box-shadow: 0 10px 22px rgba(4, 10, 24, 0.5);
		color: var(--ink);
		font-size: 10px;
		font-weight: 500;
		line-height: 1.3;
		text-align: center;
		transform: rotate(var(--tilt));
	}

	@media (min-width: 640px) {
		.hero-vine {
			width: 1.5rem;
			height: var(--len-sm);
		}

		.hero-tag {
			max-width: 7.25rem;
			padding: 0.5rem 0.6rem;
			font-size: 11px;
		}
	}

	@media (min-width: 1024px) {
		.hero-vine {
			height: var(--len-lg);
		}

		.hero-tag {
			max-width: 9.5rem;
			padding: 0.6rem 0.75rem;
			font-size: 0.875rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-point {
			animation: none;
		}
	}

	@keyframes hero-point-sway {
		from {
			transform: rotate(-1.15deg);
		}
		to {
			transform: rotate(1.15deg);
		}
	}
</style>
