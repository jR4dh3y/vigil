NVR_HTTP_ADDR=:8080
NVR_DATA_DIR=./data
NVR_RECORDINGS_DIR=./recordings
NVR_RETENTION_DAYS=7
NVR_LOG_LEVEL=info

# Encrypt camera credentials and Google Drive tokens at rest (required for Drive connect).
# Use a long random string in production.
# NVR_SECRETS_KEY=change-me-to-a-long-random-string

# Google Drive OAuth environment fallback (optional archive / offsite storage).
# These can instead be saved by an administrator in Settings -> Google Drive.
# Create an OAuth client (Web application) in Google Cloud Console:
#   1. Enable Google Drive API
#   2. Configure OAuth consent screen (scopes: drive.file, userinfo.email)
#   3. Create Web application credentials
#   4. Authorized redirect URI must match NVR_GOOGLE_REDIRECT_URL exactly
# NVR_SECRETS_KEY must be set before connecting — tokens are never stored plaintext.
# NVR_GOOGLE_CLIENT_ID=
# NVR_GOOGLE_CLIENT_SECRET=
# NVR_GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/storage/gdrive/callback
#
# When connected, nvrd archives unarchived recordings to Drive with a default
# fallback cadence of 5 minutes (batch size 50). Completed segments trigger an
# immediate archive pass. Admins can also trigger
# POST /api/v1/storage/gdrive/archive from Settings → Run archive now.

# --- Recording storage tuning ----------------------------------------------
# Fallback polling cadence for the archive loop when no segment completions
# arrive (seconds). Completed segments nudge an immediate archive pass;
# NVR_ARCHIVE_INTERVAL_SECONDS controls the backup timer.
# NVR_ARCHIVE_INTERVAL_SECONDS=300

# RAM-staging mode (opt-in): point NVR_RECORDINGS_DIR at a tmpfs mount and cap
# how long unarchived segments may stay local. Segments older than this are
# evicted oldest-first even if Drive upload failed, so a small staging volume
# never fills and recording never stalls. Unarchived footage lost this way is
# marked "skipped:expired" on the timeline. Reboots also clear tmpfs volumes.
# NVR_MAX_LOCAL_DWELL_MINUTES=60

# Used-percent of the recordings volume at which oldest-first overflow
# eviction starts (0 disables). Recommended with RAM staging: slightly above
# your expected steady-state usage, well below 100.
# NVR_LOCAL_EVICT_THRESHOLD=85

# MediaMTX (control plane + browser playback bases)
NVR_MEDIAMTX_API_URL=http://127.0.0.1:9997
NVR_MEDIAMTX_WEBRTC_URL=http://127.0.0.1:8889
NVR_MEDIAMTX_HLS_URL=http://127.0.0.1:8888
# NVR_MEDIAMTX_PLAYBACK_URL=http://127.0.0.1:9996

# --- Hosted dashboard / headless deployment -------------------------------
# Configure these when the dashboard is hosted separately from the recorder.
# The slim image relies on the hosted URL; the full image can also enable remote access.

# The externally reachable HTTPS URL of THIS recorder, as the browser sees it.
# Must be an absolute http(s) URL; use HTTPS in production. Overrides the
# persisted publicUrl setting when non-empty.
# NVR_PUBLIC_URL=https://recorder.example.com

# The hosted dashboard URL that manages this recorder. Overrides the persisted
# hostedDashboardUrl setting when non-empty. The dashboard origin is added to
# the CORS allow-list automatically.
# NVR_HOSTED_DASHBOARD_URL=https://dashboard.example.com

# Extra exact HTTPS origins allowed to make cross-origin requests to this
# recorder (comma-separated). Only exact origins; localhost development origins
# are allowed over HTTP. Non-local origins MUST be HTTPS. Do not use wildcards.
# NVR_CORS_ORIGINS=https://dashboard.example.com

# First-start admin bootstrap (idempotent, honored ONLY while the database has
# no users). Username must be non-empty after trimming; password must contain at
# least eight runes. These values are IGNORED once any user exists.
# SECURITY: the password is argon2id-hashed and never persisted, but it IS
# resident in the deployment environment. Remove NVR_ADMIN_PASSWORD after the
# first admin is created. Prefer `nvrd setup --password-stdin` for interactive
# bootstrap so the password never appears in argv or the environment.
# NVR_ADMIN_USERNAME=admin
# NVR_ADMIN_PASSWORD=change-me-strong-password
