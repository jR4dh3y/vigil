NVR_HTTP_ADDR=:8080
NVR_DATA_DIR=./data
NVR_RECORDINGS_DIR=./recordings
NVR_RETENTION_DAYS=7
NVR_LOG_LEVEL=info

# Encrypt camera credentials and Google Drive tokens at rest (required for Drive connect).
# Use a long random string in production.
# NVR_SECRETS_KEY=change-me-to-a-long-random-string

# Google Drive OAuth (optional archive / offsite storage).
# Create an OAuth client (Web application) in Google Cloud Console:
#   1. Enable Google Drive API
#   2. Configure OAuth consent screen (scopes: drive.file, userinfo.email)
#   3. Create Web application credentials
#   4. Authorized redirect URI must match NVR_GOOGLE_REDIRECT_URL exactly
# NVR_SECRETS_KEY must be set before connecting — tokens are never stored plaintext.
# NVR_GOOGLE_CLIENT_ID=
# NVR_GOOGLE_CLIENT_SECRET=
# NVR_GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/storage/gdrive/callback
#
# When connected, nvrd archives unarchived recordings to Drive daily at 00:00 UTC
# (batch size 100). Admins can also trigger POST /api/v1/storage/gdrive/archive
# from Settings → Run archive now.

# MediaMTX (control plane + browser playback bases)
NVR_MEDIAMTX_API_URL=http://127.0.0.1:9997
NVR_MEDIAMTX_WEBRTC_URL=http://127.0.0.1:8889
NVR_MEDIAMTX_HLS_URL=http://127.0.0.1:8888
# NVR_MEDIAMTX_PLAYBACK_URL=http://127.0.0.1:9996
